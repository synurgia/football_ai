def get_sources_for_competition(competition_id: str) -> List[V13Source]:
    source_ids = [
        mapping.source_id
        for mapping in V13_COMPETITION_SOURCE_MAP
        if mapping.competition_id == competition_id
    ]
    return [
        V13_SOURCES[source_id]
        for source_id in source_ids
        if source_id in V13_SOURCES
    ]


def get_sources_for_layer(layer: str) -> List[V13Source]:
    return [
        source
        for source in V13_SOURCES.values()
        if source.layer == layer
    ]


def get_all_sources() -> List[V13Source]:
    return list(V13_SOURCES.values())


def source_count() -> int:
    return len(V13_SOURCES)


def mapping_count() -> int:
    return len(V13_COMPETITION_SOURCE_MAP)


