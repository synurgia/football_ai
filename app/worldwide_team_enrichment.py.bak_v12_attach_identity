from typing import Any, Dict, Optional, Set

from app.data_providers.openfoot_provider import OpenFootProvider
from app.data_registry.team_snapshot_store import TeamSnapshotStore


class WorldwideTeamEnrichment:
    """
    Enriches daily football fixtures with real OpenFoot standings data.

    Only competitions represented in the supplied daily fixtures are
    queried. This avoids unnecessarily requesting all 120+ competitions.

    This layer does not run predictions and does not modify Pieces 1-9.
    """

    def __init__(
        self,
        provider: Optional[OpenFootProvider] = None,
        store: Optional[TeamSnapshotStore] = None,
    ):
        self.provider = provider or OpenFootProvider()
        self.store = store or TeamSnapshotStore()

    @staticmethod
    def _normalize_competition_name(value: Any) -> str:
        import re

        text = str(value or "").strip().lower()
        text = re.sub(r"\\s+", " ", text)

        # Remove competition-stage labels only.
        text = re.sub(
            r"\\s*,\\s*(league phase|group stage|regular season|"
            r"third round|quarterfinals?|round of 16|"
            r"first round.*)$",
            "",
            text,
        )

        return text.strip()

    def _resolve_openfoot_competitions(
        self,
        matches,
    ) -> Dict[str, Optional[str]]:
        catalogue = self.provider.get_competitions()

        catalogue_by_name = {}

        for item in catalogue:
            name = item.get("name")
            competition_id = item.get("id")

            if not name or not competition_id:
                continue

            normalized = self._normalize_competition_name(name)

            if normalized:
                catalogue_by_name[normalized] = competition_id

        # Explicit, verified naming aliases only.
        # These aliases represent the same competition under
        # different provider naming conventions.
        aliases = {
            "argentine nacional b": "primera nacional",
            "conmebol libertadores": "copa libertadores",
            "conmebol sudamericana": "copa sudamericana",
            "efl championship": "championship",
            "liga portugal": "primeira liga",
            "mls": "major league soccer",
            "spfl premiership": "scottish premiership",
            "south african premier": "south african premiership",
            "uefa champions league": "uefa champions league",
        }

        resolved = {}

        for match in matches:
            competition_name = str(
                match.get("competition") or ""
            ).strip()

            if not competition_name:
                continue

            normalized = self._normalize_competition_name(
                competition_name
            )

            competition_id = catalogue_by_name.get(normalized)

            if competition_id is None:
                alias_name = aliases.get(normalized)

                if alias_name is not None:
                    competition_id = catalogue_by_name.get(
                        alias_name
                    )

            resolved[competition_name] = competition_id

        return resolved

    def enrich_matches(self, matches) -> Dict[str, Any]:
        competition_names = {
            str(match.get("competition")).strip()
            for match in matches
            if match.get("competition")
        }

        resolved_competitions = self._resolve_openfoot_competitions(
            matches
        )

        competitions: Dict[str, Any] = {}
        teams_enriched = 0
        unsupported_competitions = []

        for competition_name in sorted(competition_names):
            competition_id = resolved_competitions.get(
                competition_name
            )

            if not competition_id:
                unsupported_competitions.append(
                    competition_name
                )

                competitions[competition_name] = {
                    "openfoot_competition_id": None,
                    "standings_loaded": 0,
                    "teams_enriched": 0,
                    "status": "UNSUPPORTED_BY_OPENFOOT",
                }
                continue

            standings = self.provider.get_standings(
                competition=competition_id
            )

            competition_teams = 0

            for table in standings:
                for row in table.get("table", []):
                    team = row.get("team") or {}
                    team_name = team.get("name")

                    if not team_name:
                        continue

                    total = row.get("total") or {}
                    played = total.get("played", 0) or 0

                    # Ignore placeholder/non-playing rows.
                    if played <= 0:
                        continue

                    season = ""

                    for match in matches:
                        if (
                            str(match.get("competition") or "").strip()
                            == competition_name
                        ):
                            season = match.get("season") or ""
                            if season:
                                break

                    if not season:
                        continue

                    snapshot = {
                        "matches_played": played,
                        "wins": total.get("won", 0) or 0,
                        "draws": total.get("drawn", 0) or 0,
                        "losses": total.get("lost", 0) or 0,
                        "goals_for": total.get("goalsFor", 0) or 0,
                        "goals_against": total.get(
                            "goalsAgainst", 0
                        ) or 0,
                        "goal_difference": total.get(
                            "goalDifference", 0
                        ) or 0,
                        "points": total.get("points", 0) or 0,
                        "points_per_game": (
                            (total.get("points", 0) or 0)
                            / played
                        ),
                        "league_position": row.get("position"),
                        "recent_form": row.get("form") or [],
                        "source": "openfoot",
                    }

                    self.store.upsert(
                        competition_id,
                        season,
                        team_name,
                        snapshot,
                    )

                    teams_enriched += 1
                    competition_teams += 1

            competitions[competition_name] = {
                "openfoot_competition_id": competition_id,
                "standings_loaded": len(standings),
                "teams_enriched": competition_teams,
                "status": "ENRICHED",
            }

        return {
            "competitions_processed": len(competition_names),
            "competitions_resolved": sum(
                1
                for value in resolved_competitions.values()
                if value
            ),
            "unsupported_competitions": unsupported_competitions,
            "teams_enriched": teams_enriched,
            "store_count": self.store.count(),
            "competitions": competitions,
            "provenance": {
                "provider": "openfoot",
                "source": "standings",
                "resolution": "openfoot_catalogue",
            },
        }
